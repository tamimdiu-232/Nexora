SERVICE_TOKEN=change-me-to-a-long-random-string
MAX_UPLOAD_MB=25
CHUNK_SIZE=800
CHUNK_OVERLAP=120
DATA_DIR=data
OCR_LANGS=eng
# OCR_LANGS=eng+ben   # only if Bangla tesseract data is installed (brew install tesseract-lang)
LLM_PROVIDER=extractive
# --- Optional LLM (default: none; the extractive baseline runs offline) ---
# LLM_PROVIDER=anthropic          # or: openai (any OpenAI-compatible endpoint)
# LLM_API_KEY=                    # never commit a real key
# LLM_MODEL=                      # required when a provider is set
# LLM_BASE_URL=https://api.openai.com/v1
# EXTRACTION_MODE=rules           # or: llm (fills only empty fields, evidence-checked)
